import kotlin.collections.List;
import kotlin.String;

CREATE TABLE IF NOT EXISTS restaurantEntity (
    localId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    serverId TEXT UNIQUE NOT NULL,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    photoUris TEXT AS List<String>,

    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    addressName TEXT NOT NULL,

    companyId TEXT NOT NULL,
    rating REAL DEFAULT NULL,
    deliveryCost REAL DEFAULT NULL,
    averageDeliveryTime REAL DEFAULT NULL
);

getAllRestaurants:
SELECT * FROM restaurantEntity;

getRestaurantById:
SELECT * FROM restaurantEntity
WHERE serverId = ?;

insertRestaurant:
INSERT INTO restaurantEntity (serverId, name, description, photoUris, latitude, longitude, addressName, companyId, rating, deliveryCost, averageDeliveryTime)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(serverId) DO UPDATE SET
    name = excluded.name,
    description = excluded.description,
    photoUris = excluded.photoUris,
    latitude = excluded.latitude,
    longitude = excluded.longitude,
    addressName = excluded.addressName,
    companyId = excluded.companyId,
    rating = excluded.rating,
    deliveryCost = excluded.deliveryCost,
    averageDeliveryTime = excluded.averageDeliveryTime;

deleteRestaurantByServerId:
DELETE FROM restaurantEntity
WHERE serverId = ?;

upsertRestaurant:
INSERT OR REPLACE INTO restaurantEntity
VALUES ?;