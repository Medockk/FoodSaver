import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS paymentMethodEntity (
    localId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    globalId TEXT UNIQUE ,
    bank TEXT NOT NULL,
    cardNumber TEXT NOT NULL,
    isSelected INTEGER AS Boolean NOT NULL,
    uid TEXT NOT NULL,
    tempId TEXT NOT NULL
);

getPaymentMethods:
SELECT * FROM paymentMethodEntity
WHERE uid = ?;

getCurrentPaymentMethod:
SELECT * FROM paymentMethodEntity
WHERE uid = ?
AND isSelected = 1;

addPaymentMethod:
INSERT INTO paymentMethodEntity(globalId, bank, cardNumber, isSelected, uid, tempId)
VALUES (?,?,?, ?, ?, ?);

setCurrentPaymentMethodByLocalId:
UPDATE paymentMethodEntity
SET isSelected = ?
WHERE localId = ? AND uid = ?;

setCurrentPaymentMethodByGlobalId:
UPDATE paymentMethodEntity
SET isSelected = ?
WHERE globalId = ? AND uid = ?;

removePaymentMethod:
DELETE FROM paymentMethodEntity
WHERE localId = ? AND uid = ?;

removePaymentMethodByGlobalId:
DELETE FROM paymentMethodEntity
WHERE globalId = ? AND uid = ?;

clear:
DELETE FROM paymentMethodEntity
WHERE uid = ?;

updateLocalPaymentMethod:
UPDATE paymentMethodEntity
SET globalId = ?,
isSelected = ?,
bank = ?,
cardNumber = ?
WHERE uid = ? AND tempId = ?;

deleteLocalPaymentMethod:
DELETE FROM paymentMethodEntity
WHERE tempId = ?;