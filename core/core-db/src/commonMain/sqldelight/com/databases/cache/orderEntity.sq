import com.foodsaver.app.coreModel.model.order.OrderStatus;
import com.foodsaver.app.coreModel.model.order.OrderType;
import kotlin.time.Instant;

CREATE TABLE IF NOT EXISTS orderEntity (
    id TEXT NOT NULL PRIMARY KEY,
    userId TEXT NOT NULL,

    type TEXT AS OrderType NOT NULL,
    status TEXT AS OrderStatus NOT NULL,

    restaurantImageUri TEXT,
    restaurantName TEXT NOT NULL,

    orderPrice REAL NOT NULL,
    orderSize INTEGER NOT NULL,
    trackNumber TEXT NOT NULL,

    createdAt INTEGER AS Instant NOT NULL,

    FOREIGN KEY (userId) REFERENCES userEntity (id) ON DELETE CASCADE
);

getOrderByUserId:
SELECT * FROM orderEntity
WHERE userId = ?
ORDER BY createdAt DESC;

upsertOrder:
INSERT OR REPLACE INTO orderEntity
VALUES ?;

deleteByUserId:
DELETE FROM orderEntity
WHERE userId = ?;