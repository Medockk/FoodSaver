import kotlin.String;
import kotlin.collections.List;
import kotlin.time.Instant;

CREATE TABLE productCacheEntity (
    productId TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    imageUris TEXT AS List<String>,
    price REAL NOT NULL,
    discount REAL NOT NULL,
    currency TEXT NOT NULL,
    unit TEXT NOT NULL,
    restaurantId TEXT NOT NULL,
    ingredientIds TEXT AS List<String> NOT NULL,
    expiresAt INTEGER AS Instant NOT NULL
);

upsertProduct:
INSERT OR REPLACE INTO productCacheEntity VALUES ?;

getProduct:
SELECT * FROM productCacheEntity WHERE productId = ?;

getAllProducts:
SELECT * FROM productCacheEntity;

getProductsByIds:
SELECT * FROM productCacheEntity
WHERE productId IN ?;

deleteProductById:
DELETE FROM productCacheEntity
WHERE productId = ?;

getExistingIds:
SELECT productId FROM productCacheEntity
WHERE productId IN ?;

getProductByRestaurantId:
SELECT * FROM productCacheEntity
WHERE restaurantId = ?;

deleteProductsByRestaurantId:
DELETE FROM productCacheEntity
WHERE restaurantId = ?;