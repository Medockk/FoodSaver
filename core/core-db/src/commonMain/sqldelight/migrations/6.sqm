import kotlin.String;
import kotlin.collections.List;

CREATE TABLE IF NOT EXISTS addressEntity (
    id TEXT NOT NULL PRIMARY KEY,
    userId TEXT NOT NULL,
    name TEXT NOT NULL,

    latitude REAL NOT NULL,
    longitude REAL NOT NULL,

    city TEXT NOT NULL,
    street TEXT NOT NULL,
    house TEXT NOT NULL,

    apartment TEXT,
    floor INTEGER,
    entrance TEXT,

    fullAddress TEXT NOT NULL,

    FOREIGN KEY (userId) REFERENCES userEntity (id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS address_user_id_idx ON addressEntity(userId);

ALTER TABLE userEntity ADD COLUMN currentAddressId TEXT;
ALTER TABLE userEntity ADD COLUMN currentPaymentMethodId TEXT;
ALTER TABLE userEntity ADD COLUMN addressIds TEXT AS List<String> NOT NULL DEFAULT '';
ALTER TABLE userEntity ADD COLUMN phone TEXT DEFAULT NULL ;
ALTER TABLE userEntity ADD COLUMN bio TEXT DEFAULT NULL ;