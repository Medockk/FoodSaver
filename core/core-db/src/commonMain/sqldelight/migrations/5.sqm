CREATE TABLE IF NOT EXISTS addressEntity(
    localId INTEGER PRIMARY KEY AUTOINCREMENT,
    globalId TEXT UNIQUE,
    name TEXT,
    address TEXT NOT NULL,
    isCurrentAddress INTEGER AS Boolean NOT NULL,
    tempId TEXT NOT NULL,
    uid TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS userEntity_new (
    uid TEXT NOT NULL PRIMARY KEY,
    username TEXT NOT NULL,
    email TEXT,
    name TEXT,
    photoUrl TEXT,
    createdAt INTEGER AS Instant NOT NULL,
    roles TEXT AS List<String> NOT NULL,

    phone TEXT,
    bio TEXT
);

INSERT INTO userEntity_new (uid, username, email, name, photoUrl, createdAt, roles, phone, bio)
SELECT uid, username, email, name, photoUrl, createdAt, roles, phone, bio FROM userEntity;

DROP TABLE userEntity;

ALTER TABLE userEntity_new RENAME TO userEntity;