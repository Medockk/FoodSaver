CREATE TABLE IF NOT EXISTS userEntity_new (
    uid TEXT NOT NULL PRIMARY KEY,
    username TEXT NOT NULL,
    email TEXT,
    name TEXT,
    photoUrl TEXT,
    createdAt INTEGER AS Instant NOT NULL,
    roles TEXT AS List<String> NOT NULL,

    phone TEXT,
    bio TEXT,
    addresses TEXT AS List<AddressDto> NOT NULL,
    currentCity TEXT
);

INSERT INTO userEntity_new (uid, username, email, name, photoUrl, createdAt, roles, phone, bio, addresses, currentCity)
SELECT uid, username, email, name, photoUrl, createdAt, roles, phone, bio, addresses, currentCity FROM userEntity;

DROP TABLE userEntity;

ALTER TABLE userEntity_new RENAME TO userEntity;